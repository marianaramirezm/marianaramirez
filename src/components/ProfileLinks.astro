---
import SocialIcon from './SocialIcon.astro';
import { site, type ProfileId } from '../data/site';
import type { Locale, UiKey } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
  ids?: ProfileId[];
  /** Write the @handle on the Instagram link. */
  showHandle?: boolean;
  labelledBy?: string;
}

const { locale, ids, showHandle = false, labelledBy } = Astro.props;
const label: Record<ProfileId, UiKey> = {
  serhant: 'link.serhant',
  instagram: 'link.instagram',
  tiktok: 'link.tiktok',
};
const order = ids ?? site.profiles.map((item) => item.id);
const links = order.flatMap((id) => {
  const item = site.profiles.find((profile) => profile.id === id);
  return item ? [item] : [];
});

function ariaLabel(id: ProfileId): string {
  const name = t(locale, label[id]);
  const tab = t(locale, 'a11y.newTab');
  if (id === 'instagram') return `${name}, ${site.handle} (${tab})`;
  return `${name} (${tab})`;
}
---

<ul class="profile-links" aria-labelledby={labelledBy}>
  {
    links.map((item) => (
      <li>
        <a
          class:list={{ 'is-instagram': item.id === 'instagram' }}
          href={item.href}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={ariaLabel(item.id)}
        >
          {(item.id === 'instagram' || item.id === 'tiktok') && <SocialIcon name={item.id} />}
          {showHandle && item.id === 'instagram' ? (
            <span class="ig-copy">
              <span class="ig-name">{t(locale, label[item.id])}</span>
              <span class="handle">{site.handle}</span>
            </span>
          ) : (
            t(locale, label[item.id])
          )}
        </a>
      </li>
    ))
  }
</ul>
