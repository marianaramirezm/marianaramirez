---
import { Picture } from 'astro:assets';
import contactPhoto from '../assets/photos/mariana-bar.jpg';
import ProfileLinks from '../components/ProfileLinks.astro';
import { site } from '../data/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import Base from '../layouts/Base.astro';
import { getNeighborhoods } from '../lib/content';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { pathFor } from '../lib/routes';
import { breadcrumbNode, graph } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const origin = Astro.site ?? new URL('https://marianaramirezrealestate.com');
const neighborhoods = await getNeighborhoods();
const path = pathFor('contact', locale);
const alternate = pathFor('contact', locale === 'en' ? 'es' : 'en');
const crumbs = [
  { name: t(locale, 'nav.home'), path: pathFor('home', locale) },
  { name: t(locale, 'nav.contact'), path },
];
---

<Base
  locale={locale}
  title={t(locale, 'meta.contact.title')}
  description={t(locale, 'meta.contact.description')}
  path={path}
  alternatePath={alternate}
  current="contact"
  jsonLd={graph(breadcrumbNode(origin, crumbs))}
>
  <div class="wrap page-intro">
    <Breadcrumbs locale={locale} items={crumbs} />
  </div>
  <div class="wrap page-body">
    <div class="contact-grid">
      <div>
        <figure class="contact-photo">
          <Picture
            src={contactPhoto}
            alt={t(locale, 'home.contactPhotoAlt')}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 32rem, 100vw"
            quality={70}
          />
        </figure>
        <p class="eyebrow">{t(locale, 'contact.eyebrow')}</p>
        <h1>{t(locale, 'contact.title')}</h1>
        <p class="lead">{t(locale, 'contact.lead')}</p>
        <p>
          <a href={`tel:${site.publicPhone.replace(/[^\d+]/g, '')}`}>{site.publicPhone}</a><br />
          <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
        </p>
        <ProfileLinks locale={locale} ids={['instagram', 'tiktok', 'serhant']} showHandle variant="pills" />
      </div>
      <ContactForm locale={locale} neighborhoods={neighborhoods} />
    </div>
  </div>
</Base>
