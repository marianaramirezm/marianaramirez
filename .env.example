# Canonical origin for sitemap, canonical URLs, Open Graph, and JSON-LD.
# No trailing path.
SITE_URL=https://marianaramirezrealestate.com

# preview   — validate locally and open the thank-you page. Nothing is emailed.
# netlify   — post the form to Netlify Forms (set this on Netlify; see netlify.toml).
# endpoint  — POST to PUBLIC_FORM_ENDPOINT (Formspree or any compatible URL).
PUBLIC_FORM_MODE=preview

# Full form endpoint. Leave empty until she chooses a provider.
# Example: https://formspree.io/f/xxxxxxxx
# Leads are delivered by that provider. Do not put an email address here.
PUBLIC_FORM_ENDPOINT=
