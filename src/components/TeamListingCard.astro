---
import { Picture } from 'astro:assets';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { listingPath } from '../lib/routes';
import type { TeamListingEntry } from '../lib/types';

interface Props {
  locale: Locale;
  listing: TeamListingEntry;
  variant?: 'full' | 'address';
}

const { locale, listing, variant = 'full' } = Astro.props;
const href = listingPath(listing.id, locale);
const photo = listing.data.photos[0];
const specs = [
  [t(locale, 'listings.price'), listing.data.price[locale]],
  [t(locale, 'listings.beds'), listing.data.beds[locale]],
  listing.data.baths ? [t(locale, 'listings.baths'), listing.data.baths[locale]] : null,
  [t(locale, 'listings.sqft'), listing.data.sqft[locale]],
].filter((item): item is [string, string] => item !== null);
---

<article>
  <a class="card" href={href}>
    {
      photo ? (
        <div class="card-media">
          <Picture
            src={photo.src}
            alt={photo.alt[locale]}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200]}
            sizes="(min-width: 800px) 36rem, 100vw"
            quality={70}
          />
        </div>
      ) : (
        <div class="card-media type-card">
          <p class="type-card-kicker">{listing.data.area[locale]}</p>
          <p class="type-card-name">{listing.data.name[locale]}</p>
        </div>
      )
    }
    <h3>{listing.data.name[locale]}</h3>
    {
      variant === 'address' ? (
        <p class="where">{listing.data.address[locale]}</p>
      ) : (
        <p class="where">
          {listing.data.area[locale]}
          <span aria-hidden="true"> · </span>
          {listing.data.statusLabel[locale]}
        </p>
      )
    }
    {variant === 'full' && (
      <dl class="specs">
        {specs.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )}
    <p class="where">{listing.data.credit}</p>
  </a>
</article>
