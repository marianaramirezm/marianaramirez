---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { listingPath } from '../lib/routes';
import type { TeamListingEntry } from '../lib/types';

interface Props {
  locale: Locale;
  listing: TeamListingEntry;
  variant?: 'full' | 'address';
}

const { locale, listing, variant = 'full' } = Astro.props;
const href = listingPath(listing.id, locale);
const photo = listing.data.photos[0];
const status =
  listing.data.status === 'sold'
    ? t(locale, 'listings.statusSold')
    : listing.data.status === 'leased'
      ? t(locale, 'listings.leased')
      : t(locale, 'listings.statusActive');
---

<article>
  <a class="card" href={href}>
    <div class="card-media">
      {
        photo && (
          <Image
            src={photo}
            alt={listing.data.name[locale]}
            widths={[480, 800, 1200]}
            sizes="(min-width: 800px) 36rem, 100vw"
            quality={70}
          />
        )
      }
    </div>
    <h3>{listing.data.name[locale]}</h3>
    {
      variant === 'address' ? (
        <p class="where">{listing.data.address[locale]}</p>
      ) : (
        <p class="where">
          {listing.data.area[locale]}
          <span aria-hidden="true"> · </span>
          {status}
        </p>
      )
    }
    {variant === 'full' && (
      <dl class="specs">
        <div>
          <dt>{t(locale, 'listings.price')}</dt>
          <dd>{listing.data.price[locale]}</dd>
        </div>
        <div>
          <dt>{t(locale, 'listings.beds')}</dt>
          <dd>{listing.data.beds[locale]}</dd>
        </div>
        <div>
          <dt>{t(locale, 'listings.baths')}</dt>
          <dd>{listing.data.baths[locale]}</dd>
        </div>
        <div>
          <dt>{t(locale, 'listings.sqft')}</dt>
          <dd>{listing.data.sqft[locale]}</dd>
        </div>
      </dl>
    )}
    <p class="where">{listing.data.credit}</p>
  </a>
</article>
