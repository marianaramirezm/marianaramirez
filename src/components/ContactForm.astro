---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { formEndpoint, formMode } from '../lib/form-mode';
import { pathFor } from '../lib/routes';
import type { GuideEntry } from '../lib/types';
import { BUDGET_VALUES, EXTRA_NEIGHBORHOODS, INTEREST_VALUES, LANGUAGE_VALUES } from '../lib/validate';

interface Props {
  locale: Locale;
  neighborhoods: GuideEntry[];
}

const { locale, neighborhoods } = Astro.props;
const mode = formMode();
const endpoint = formEndpoint();
const thanks = pathFor('thanks', locale);
const defaultLanguage = locale === 'es' ? 'Spanish' : 'English';

const interests = [
  { value: INTEREST_VALUES[0], label: t(locale, 'opt.buy') },
  { value: INTEREST_VALUES[1], label: t(locale, 'opt.sell') },
  { value: INTEREST_VALUES[2], label: t(locale, 'opt.rent') },
  { value: INTEREST_VALUES[3], label: t(locale, 'opt.invest') },
] as const;

const languages = [
  { value: LANGUAGE_VALUES[0], label: t(locale, 'opt.lang.en') },
  { value: LANGUAGE_VALUES[1], label: t(locale, 'opt.lang.es') },
] as const;

const budgets = [
  { value: BUDGET_VALUES[0], label: t(locale, 'opt.budget.discuss') },
  { value: BUDGET_VALUES[1], label: t(locale, 'opt.budget.u1') },
  { value: BUDGET_VALUES[2], label: t(locale, 'opt.budget.1_2') },
  { value: BUDGET_VALUES[3], label: t(locale, 'opt.budget.2_5') },
  { value: BUDGET_VALUES[4], label: t(locale, 'opt.budget.5_10') },
  { value: BUDGET_VALUES[5], label: t(locale, 'opt.budget.10p') },
] as const;

const areas = [
  ...neighborhoods.map((item) => ({ value: item.data.name.en, label: item.data.name[locale] })),
  { value: EXTRA_NEIGHBORHOODS[0], label: t(locale, 'opt.other') },
  { value: EXTRA_NEIGHBORHOODS[1], label: t(locale, 'opt.unsure') },
];
---

<form
  class="fields"
  name="contact"
  method="POST"
  action={thanks}
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  data-contact-form
  data-locale={locale}
  data-form-mode={mode}
  data-form-endpoint={endpoint}
  data-thanks={thanks}
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="subject" value="Website inquiry" />

  <p class="hp">
    <label>
      {t(locale, 'contact.honeypot')}
      <input name="bot-field" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="form-alert" data-error-summary hidden tabindex="-1">
    <p>{t(locale, 'contact.errorSummary')}</p>
    <ul data-error-list></ul>
  </div>
  <p class="form-alert" data-send-error hidden tabindex="-1">{t(locale, 'contact.sendError')}</p>

  <div class="pair">
    <div class="field" data-field="name">
      <label class="lbl" for="name">{t(locale, 'contact.name')}</label>
      <input id="name" name="name" type="text" autocomplete="name" required maxlength="80" />
      <p class="field-error" data-field-error hidden></p>
    </div>
    <div class="field" data-field="email">
      <label class="lbl" for="email">{t(locale, 'contact.email')}</label>
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="120" />
      <p class="field-error" data-field-error hidden></p>
    </div>
  </div>

  <div class="pair">
    <div class="field" data-field="phone">
      <label class="lbl" for="phone">
        {t(locale, 'contact.phone')} <span class="optional">({t(locale, 'contact.phoneOptional')})</span>
      </label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" />
      <p class="field-error" data-field-error hidden></p>
    </div>
    <div class="field" data-field="language">
      <label class="lbl" for="language">{t(locale, 'contact.language')}</label>
      <select id="language" name="language" required>
        {
          languages.map((option) => (
            <option value={option.value} selected={option.value === defaultLanguage}>
              {option.label}
            </option>
          ))
        }
      </select>
      <p class="field-error" data-field-error hidden></p>
    </div>
  </div>

  <div class="pair">
    <div class="field" data-field="interest">
      <label class="lbl" for="interest">{t(locale, 'contact.interest')}</label>
      <select id="interest" name="interest" required>
        <option value="">{t(locale, 'contact.choose')}</option>
        {interests.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
      <p class="field-error" data-field-error hidden></p>
    </div>
    <div class="field" data-field="neighborhood">
      <label class="lbl" for="neighborhood">{t(locale, 'contact.neighborhood')}</label>
      <select id="neighborhood" name="neighborhood" required>
        <option value="">{t(locale, 'contact.choose')}</option>
        {areas.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
      <p class="field-error" data-field-error hidden></p>
    </div>
  </div>

  <div class="field" data-field="budget">
    <label class="lbl" for="budget">{t(locale, 'contact.budget')}</label>
    <select id="budget" name="budget" required>
      <option value="">{t(locale, 'contact.choose')}</option>
      {budgets.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
    <p class="field-error" data-field-error hidden></p>
  </div>

  <div class="field" data-field="message">
    <label class="lbl" for="message">{t(locale, 'contact.message')}</label>
    <textarea id="message" name="message" required minlength="10" maxlength="2000"></textarea>
    <p class="field-error" data-field-error hidden></p>
  </div>

  <div class="field" data-field="consent">
    <label class="consent" for="consent">
      <input id="consent" name="consent" type="checkbox" value="yes" required />
      <span>{t(locale, 'contact.consent')}</span>
    </label>
    <p class="field-error" data-field-error hidden></p>
  </div>

  <button class="button" type="submit" data-label={t(locale, 'contact.submit')} data-sending={t(locale, 'contact.sending')}>
    {t(locale, 'contact.submit')}
  </button>
</form>

{
  mode === 'preview' && (
    <p class="preview-note">
      <span class="todo-tag">TODO</span>
      {t(locale, 'contact.previewNote')}
    </p>
  )
}

<script>
  import { ui, type Locale } from '../i18n/ui';
  import { contactFromFormData, validateContact, type ContactErrorCode } from '../lib/validate';

  function messageFor(locale: Locale, code: ContactErrorCode): string {
    const key = `err.${code}` as const;
    return ui[locale][key];
  }

  function clearErrors(form: HTMLFormElement) {
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const list = form.querySelector<HTMLUListElement>('[data-error-list]');
    if (summary) summary.hidden = true;
    if (list) list.replaceChildren();
    form.querySelectorAll<HTMLElement>('[data-field]').forEach((field) => {
      delete field.dataset.invalid;
      const message = field.querySelector<HTMLElement>('[data-field-error]');
      if (message) {
        message.hidden = true;
        message.textContent = '';
      }
      field.querySelector('input, select, textarea')?.removeAttribute('aria-invalid');
    });
  }

  function setup(form: HTMLFormElement) {
    const locale = (form.dataset.locale === 'es' ? 'es' : 'en') as Locale;
    const thanks = form.dataset.thanks || '/thank-you/';
    const mode = form.dataset.formMode || 'preview';
    const endpoint = form.dataset.formEndpoint || '';
    const neighborhoods = [...form.querySelectorAll<HTMLOptionElement>('#neighborhood option')]
      .map((option) => option.value)
      .filter(Boolean);
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const list = form.querySelector<HTMLUListElement>('[data-error-list]');
    const sendError = form.querySelector<HTMLElement>('[data-send-error]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.noValidate = true;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = contactFromFormData(new FormData(form));
      if (input.honeypot) {
        window.location.href = thanks;
        return;
      }

      const errors = validateContact(input, neighborhoods);
      const codes = Object.keys(errors) as ContactErrorCode[];
      clearErrors(form);
      if (sendError) sendError.hidden = true;

      if (codes.length > 0) {
        if (summary && list) {
          summary.hidden = false;
          for (const code of codes) {
            const text = messageFor(locale, code);
            const item = document.createElement('li');
            item.textContent = text;
            list.append(item);
            const field = form.querySelector<HTMLElement>(`[data-field="${code}"]`);
            const message = field?.querySelector<HTMLElement>('[data-field-error]');
            if (field) field.dataset.invalid = 'true';
            if (message) {
              message.hidden = false;
              message.textContent = text;
            }
            field?.querySelector('input, select, textarea')?.setAttribute('aria-invalid', 'true');
          }
          summary.focus();
        }
        return;
      }

      if (endpoint) {
        if (button) {
          button.disabled = true;
          button.textContent = button.dataset.sending || button.textContent;
        }
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error(String(response.status));
          window.location.href = thanks;
        } catch {
          if (button) {
            button.disabled = false;
            button.textContent = button.dataset.label || button.textContent;
          }
          if (sendError) {
            sendError.hidden = false;
            sendError.focus();
          }
        }
        return;
      }

      if (mode === 'netlify') {
        form.submit();
        return;
      }

      window.location.href = thanks;
    });
  }

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(setup);
</script>
