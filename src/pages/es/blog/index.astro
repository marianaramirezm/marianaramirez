---
import BlogIndex from '../../../views/BlogIndex.astro';
import { blogPageCount, getBlogPosts, postsForPage } from '../../../lib/blog';
import { blogPagePath } from '../../../lib/routes';

const posts = await getBlogPosts('es');
const page = 1;
const pageCount = blogPageCount(posts.length);
---

<BlogIndex
  locale="es"
  posts={postsForPage(posts, page)}
  page={page}
  pageCount={pageCount}
  alternatePath={blogPagePath(1, 'en')}
/>
