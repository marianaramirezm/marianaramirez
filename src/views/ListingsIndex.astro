---
import { site } from '../data/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ListingCard from '../components/ListingCard.astro';
import TeamListingCard from '../components/TeamListingCard.astro';
import Base from '../layouts/Base.astro';
import { getListings, getNeighborhoods, getTeamListings } from '../lib/content';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { pathFor } from '../lib/routes';
import { breadcrumbNode, graph } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const origin = Astro.site ?? new URL('https://marianaramirezrealestate.com');
const listings = await getListings();
const team = await getTeamListings();
const neighborhoods = await getNeighborhoods();
const active = listings.filter((item) => item.data.status === 'active');
const sold = listings.filter((item) => item.data.status === 'sold');
const leased = listings.filter((item) => item.data.status === 'leased');
const teamActive = team.filter((item) => item.data.status === 'active');
const teamSold = team.filter((item) => item.data.status === 'sold');
const teamLeased = team.filter((item) => item.data.status === 'leased');
const path = pathFor('listings', locale);
const alternate = pathFor('listings', locale === 'en' ? 'es' : 'en');
const crumbs = [
  { name: t(locale, 'nav.home'), path: pathFor('home', locale) },
  { name: t(locale, 'nav.listings'), path },
];
---

<Base
  locale={locale}
  title={t(locale, 'meta.listings.title')}
  description={t(locale, 'meta.listings.description')}
  path={path}
  alternatePath={alternate}
  current="listings"
  jsonLd={graph(breadcrumbNode(origin, crumbs))}
>
  <div class="wrap page-intro">
    <Breadcrumbs locale={locale} items={crumbs} />
    <p class="eyebrow">{t(locale, 'listings.eyebrow')}</p>
    <h1>{t(locale, 'listings.title')}</h1>
    <p class="lead">{t(locale, 'listings.lead')}</p>
    <p class="stack-links">
      <a class="link" href={site.profiles[0].href} rel="noopener noreferrer">{t(locale, 'home.liveListings')}</a>
    </p>
  </div>
  <div class="wrap page-body">
    {
      (active.length > 0 || teamActive.length > 0) && (
        <section>
          <h2 class="display">{t(locale, 'listings.active')}</h2>
          <div class="cards">
            {teamActive.map((listing) => (
              <TeamListingCard locale={locale} listing={listing} />
            ))}
            {active.map((listing) => (
              <ListingCard locale={locale} listing={listing} neighborhoods={neighborhoods} />
            ))}
          </div>
        </section>
      )
    }
    {
      (leased.length > 0 || teamLeased.length > 0) && (
        <section style="margin-top: 3.5rem;">
          <h2 class="display">{t(locale, 'listings.leased')}</h2>
          <div class="cards">
            {teamLeased.map((listing) => (
              <TeamListingCard locale={locale} listing={listing} />
            ))}
            {leased.map((listing) => (
              <ListingCard locale={locale} listing={listing} neighborhoods={neighborhoods} />
            ))}
          </div>
        </section>
      )
    }
    {
      (sold.length > 0 || teamSold.length > 0) && (
        <section style="margin-top: 3.5rem;">
          <h2 class="display">{t(locale, 'listings.sold')}</h2>
          <div class="cards">
            {teamSold.map((listing) => (
              <TeamListingCard locale={locale} listing={listing} />
            ))}
            {sold.map((listing) => (
              <ListingCard locale={locale} listing={listing} neighborhoods={neighborhoods} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
