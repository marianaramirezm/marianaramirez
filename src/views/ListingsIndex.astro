---
import { site } from '../data/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeamListingCard from '../components/TeamListingCard.astro';
import Base from '../layouts/Base.astro';
import { getTeamListings } from '../lib/content';
import type { Locale, UiKey } from '../i18n/ui';
import { t } from '../i18n/utils';
import { pathFor } from '../lib/routes';
import { breadcrumbNode, graph } from '../lib/schema';
import type { TeamListingGroup } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const origin = Astro.site ?? new URL('https://marianaramirezrealestate.com');
const team = await getTeamListings();
const path = pathFor('listings', locale);
const alternate = pathFor('listings', locale === 'en' ? 'es' : 'en');
const crumbs = [
  { name: t(locale, 'nav.home'), path: pathFor('home', locale) },
  { name: t(locale, 'nav.listings'), path },
];
const groups: [TeamListingGroup, UiKey][] = [
  ['mariana', 'listings.groupMariana'],
  ['active', 'listings.groupActive'],
  ['lease', 'listings.groupLease'],
  ['sold', 'listings.groupSold'],
  ['previously', 'listings.groupPrevious'],
];
---

<Base
  locale={locale}
  title={t(locale, 'meta.listings.title')}
  description={t(locale, 'meta.listings.description')}
  path={path}
  alternatePath={alternate}
  current="listings"
  jsonLd={graph(breadcrumbNode(origin, crumbs))}
>
  <div class="wrap page-intro">
    <Breadcrumbs locale={locale} items={crumbs} />
    <p class="eyebrow">{t(locale, 'listings.eyebrow')}</p>
    <h1>{t(locale, 'listings.title')}</h1>
    <p class="lead">{t(locale, 'listings.lead')}</p>
    <p class="stack-links">
      <a class="link" href={site.profiles[0].href} rel="noopener noreferrer">{t(locale, 'home.liveListings')}</a>
    </p>
  </div>
  <div class="wrap page-body">
    {
      groups.map(([group, label]) => {
        const items = team.filter((listing) => listing.data.group === group);
        if (items.length === 0) return null;
        return (
          <section class="listing-group">
            <h2>{t(locale, label)}</h2>
            <div class="cards">
              {items.map((listing) => (
                <TeamListingCard locale={locale} listing={listing} feature={group === 'mariana'} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</Base>
