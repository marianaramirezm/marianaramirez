---
import ListingDetail from '../../../views/ListingDetail.astro';
import TeamListingDetail from '../../../views/TeamListingDetail.astro';
import { getListings, getTeamListings } from '../../../lib/content';
import type { ListingEntry, TeamListingEntry } from '../../../lib/types';

export async function getStaticPaths() {
  const listings = await getListings();
  const team = await getTeamListings();
  const ids = new Set<string>();
  for (const listing of [...listings, ...team]) {
    if (ids.has(listing.id)) throw new Error(`Duplicate listing slug: ${listing.id}`);
    ids.add(listing.id);
  }
  return [
    ...listings.map((listing) => ({
      params: { slug: listing.id },
      props: { kind: 'profile' as const, listing },
    })),
    ...team.map((listing) => ({
      params: { slug: listing.id },
      props: { kind: 'team' as const, listing },
    })),
  ];
}

interface Props {
  kind: 'profile' | 'team';
  listing: ListingEntry | TeamListingEntry;
}

const { kind, listing } = Astro.props;
---

{kind === 'team' ? (
  <TeamListingDetail locale="es" listing={listing as TeamListingEntry} />
) : (
  <ListingDetail locale="es" listing={listing as ListingEntry} />
)}
