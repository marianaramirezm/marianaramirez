---
import BlogIndex from '../../views/BlogIndex.astro';
import { blogPageCount, getPublishedBlogPosts, postsForPage } from '../../lib/blog';
import { blogPagePath } from '../../lib/routes';

const posts = await getPublishedBlogPosts('en');
const page = 1;
const pageCount = blogPageCount(posts.length);
---

<BlogIndex
  locale="en"
  posts={postsForPage(posts, page)}
  page={page}
  pageCount={pageCount}
  alternatePath={blogPagePath(1, 'es')}
/>
