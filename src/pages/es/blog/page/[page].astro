---
import BlogIndex from '../../../../views/BlogIndex.astro';
import { BLOG_PAGE_SIZE, getBlogPosts, postsForPage } from '../../../../lib/blog';
import { blogPagePath } from '../../../../lib/routes';

export async function getStaticPaths() {
  const posts = await getBlogPosts('es');
  const other = await getBlogPosts('en');
  const pageCount = Math.ceil(posts.length / BLOG_PAGE_SIZE);
  const otherCount = Math.ceil(other.length / BLOG_PAGE_SIZE);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: { page, pageCount, alternatePath: blogPagePath(page <= otherCount ? page : 1, 'en') },
    };
  });
}

const { page, pageCount, alternatePath } = Astro.props;
const posts = postsForPage(await getBlogPosts('es'), page);
---

<BlogIndex locale="es" posts={posts} page={page} pageCount={pageCount} alternatePath={alternatePath} />
