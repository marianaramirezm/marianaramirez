---
import TeamListingDetail from '../../views/TeamListingDetail.astro';
import { getTeamListings } from '../../lib/content';

export async function getStaticPaths() {
  const team = await getTeamListings();
  return team.map((listing) => ({
    params: { slug: listing.id },
    props: { listing },
  }));
}

const { listing } = Astro.props;
---

<TeamListingDetail locale="en" listing={listing} />
